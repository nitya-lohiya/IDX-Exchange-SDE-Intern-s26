# Copy this file to `.env` and fill in your own key, then restart `npm run dev`.
# Vite only exposes variables that start with VITE_ (REACT_APP_ also works here,
# see envPrefix in vite.config.js). Anything in this file ships to the browser,
# so restrict the key in Google Cloud Console to the Maps Embed API and
# localhost:3000.
VITE_GOOGLE_MAPS_API_KEY=your_key_here
